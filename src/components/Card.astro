---
const { name, position, aboutMe, linkedin, profileImage } = Astro.props;

import '../styles/card.css';
---

<div class="container">
  <div class="card-container">
    <div class="descripcion">
      <h1>{name}</h1>
      <h2>{position}</h2>
      <p>{aboutMe}</p>
      <div class="icons">
        <a href={linkedin} class="hover-text" target="_blank">
          <span class="tooltip-text" id="fade">LinkedIn</span>
          <i class="bi bi-linkedin"></i>
        </a>
      </div>
    </div>
    <div class="image">
      <img src={profileImage} alt="Gene Strelnikov">
    </div>
  </div>
</div>
