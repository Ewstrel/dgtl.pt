---
import '../styles/site.css';

const title = 'Gene Strelnikov';
const description = 'Marketing and promotional services for films and TV series.';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <div class="container">
        <section class="card">
          <div class="content">
            <h1>Gene Strelnikov</h1>
            <h2>Head of Promo &amp; Special projects</h2>
            <p>
              I provide end-to-end marketing and promotional services for films and TV series —
              from trailers and key visuals to ad placements on streaming platforms and cinemas,
              creative campaigns, special projects, premieres, and strategic partnerships with local
              media and influencers.
            </p>
            <div class="actions">
              <a href="https://www.linkedin.com/in/ewstrel/" target="_blank" aria-label="LinkedIn">
                <i class="bi bi-linkedin"></i>
              </a>
            </div>
          </div>
          <div class="image-wrap">
            <img src="/images/zoom2.jpg" alt="Gene Strelnikov" />
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
